<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local output directory used by `dotnet pack` / CI. The directory must
         exist before restore; `dotnet pack -o ./nupkgs` creates it. -->
    <add key="local-fuzzyscorer" value="./nupkgs" />
  </packageSources>
</configuration>
